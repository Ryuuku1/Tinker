{
  "env": {
    "PLAYWRIGHT_MCP_ISOLATED": "true",
    "PLAYWRIGHT_MCP_ALLOWED_ORIGINS": "http://localhost:*;https://localhost:*;http://127.0.0.1:*;https://127.0.0.1:*",
    "PLAYWRIGHT_MCP_OUTPUT_DIR": ".tinker/playwright",
    "PLAYWRIGHT_MCP_CAPS": "network"
  },
  "permissions": {
    "allow": [
      "Edit(/.tinker/retros/**)",
      "Edit(/.tinker/tasks/**)",
      "Edit(/.tinker/reports/**)",
      "Edit(/.tinker/evidence/**)",
      "Edit(/.tinker/patches/**)"
    ],
    "deny": [
      "Bash(git *branch* -M *)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push*--mirror*)",
      "Bash(git *push* +*)",
      "Bash(git *reset*--hard*)",
      "Bash(git clean -*)",
      "Bash(git -C * clean -*)",
      "Bash(git *checkout -f*)",
      "Bash(git *checkout --force*)",
      "Bash(git *checkout -- *)",
      "Bash(git *checkout .)",
      "Bash(git *switch -f*)",
      "Bash(git *switch --force*)",
      "Bash(git *switch*--discard-changes*)",
      "Bash(git restore *)",
      "Bash(git -C * restore *)",
      "Bash(git *branch* -D *)",
      "Bash(git *branch*--force*)",
      "Bash(git *branch* -f*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(git *worktree remove*--force*)",
      "Bash(git *worktree remove* -f*)",
      "Bash(git *update-ref -d*)",
      "Bash(git *reflog expire*)",
      "Bash(git *reflog delete*)",
      "Bash(git *gc*--prune=now*)",
      "PowerShell(git *branch* -M *)",
      "PowerShell(git *push*--force*)",
      "PowerShell(git *push* -f*)",
      "PowerShell(git *push*--mirror*)",
      "PowerShell(git *push* +*)",
      "PowerShell(git *reset*--hard*)",
      "PowerShell(git clean -*)",
      "PowerShell(git -C * clean -*)",
      "PowerShell(git *checkout -f*)",
      "PowerShell(git *checkout --force*)",
      "PowerShell(git *checkout -- *)",
      "PowerShell(git *checkout .)",
      "PowerShell(git *switch -f*)",
      "PowerShell(git *switch --force*)",
      "PowerShell(git *switch*--discard-changes*)",
      "PowerShell(git restore *)",
      "PowerShell(git -C * restore *)",
      "PowerShell(git *branch* -D *)",
      "PowerShell(git *branch*--force*)",
      "PowerShell(git *branch* -f*)",
      "PowerShell(git *stash drop*)",
      "PowerShell(git *stash clear*)",
      "PowerShell(git *worktree remove*--force*)",
      "PowerShell(git *worktree remove* -f*)",
      "PowerShell(git *update-ref -d*)",
      "PowerShell(git *reflog expire*)",
      "PowerShell(git *reflog delete*)",
      "PowerShell(git *gc*--prune=now*)"
    ],
    "ask": [
      "Bash(git *push*--delete*)",
      "Bash(git *push* -d *)",
      "Bash(git *push* :*)",
      "PowerShell(git *push*--delete*)",
      "PowerShell(git *push* -d *)",
      "PowerShell(git *push* :*)"
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  }
}

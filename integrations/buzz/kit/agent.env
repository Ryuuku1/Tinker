# Every agent's safe buzz-acp settings, as environment variables (flags are invisible to Tinker's checks).
# Start-Agent adds each agent's relay URL, owner, channels, prompt and role, and refuses to start if these drift.
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
BUZZ_ACP_PERMISSION_MODE=dont-ask
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
BUZZ_ACP_NO_MEMORY=true
BUZZ_ACP_HEARTBEAT_INTERVAL=0
BUZZ_ACP_RELAY_OBSERVER=false
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=5
BUZZ_ACP_MAX_TURN_DURATION=3600
RUST_LOG=info

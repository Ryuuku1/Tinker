# Every agent's safe buzz-acp settings, as environment variables (flags are invisible to Tinker's checks).
# Start-Agent adds each agent's relay URL, owner, channels, prompt, role and allowlist, and refuses to start if these
# drift. allowlist admits the owner (always, by buzz-acp's rule) and the pubkeys Start-Agent lists: Tinker Flow only.
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
BUZZ_ACP_PERMISSION_MODE=dont-ask
BUZZ_ACP_RESPOND_TO=allowlist
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only,allowlist
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
BUZZ_ACP_NO_MEMORY=true
BUZZ_ACP_HEARTBEAT_INTERVAL=0
BUZZ_ACP_RELAY_OBSERVER=false
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=5
BUZZ_ACP_MAX_TURN_DURATION=3600
RUST_LOG=info
# Fewer tokens per session: the kit's short Buzz base prompt (the built-in one is 17.7 KB and teaches memory,
# projects and agent creation), no commit and PR instructions (agents never commit), no auto memory.
BUZZ_ACP_BASE_PROMPT_FILE=/kit/base.md
CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
# Git config from the command line outranks a repository's .git/config, which a writer agent controls: no fsmonitor
# program runs on git status and no hook runs, whoever wrote the repository.
GIT_CONFIG_COUNT=2
GIT_CONFIG_KEY_0=core.fsmonitor
GIT_CONFIG_VALUE_0=false
GIT_CONFIG_KEY_1=core.hooksPath
GIT_CONFIG_VALUE_1=/dev/null
